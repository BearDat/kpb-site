NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_LEAGUE_ID=league_xxxxxxxx

# Media uploads (highlight clips, news attachments) go to a Cloudflare R2
# bucket, accessed via a binding declared in wrangler.jsonc (MEDIA_BUCKET) —
# see README's "Deploying (Cloudflare Workers)" section. Nothing to set here
# for that; `next dev`/`wrangler dev` both pick up local-emulated bindings
# automatically.

# Maintenance mode — see README's "Maintenance mode" section. Set
# MAINTENANCE_MODE=true to show the maintenance page to everyone; leave
# MAINTENANCE_BYPASS_SECRET blank to disable the bypass entirely.
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_SECRET=

# Discord bot (all optional — see README's "Discord bot" section)
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_ADMIN_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_ID=
