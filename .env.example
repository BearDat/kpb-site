NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_LEAGUE_ID=league_xxxxxxxx

# Media uploads (highlight clips, news attachments) go to Vercel Blob, not
# Supabase Storage. In production this is auto-injected once a Blob store
# is connected to the project (Vercel dashboard -> Storage -> Create ->
# Blob), so it doesn't need setting by hand there. For local dev, run
# `vercel env pull .env.local` after connecting the store to get it.
BLOB_READ_WRITE_TOKEN=

# Discord bot (all optional — see README's "Discord bot" section)
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_ADMIN_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_ID=
